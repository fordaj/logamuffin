cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Python (integration tests)
__pycache__/
*.py[cod]

# Python tooling (uv / formattington)
.venv/

# Generated version header (fordaj/Versioner via tools/generate_version.bash)
.version/
